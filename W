-- ===== น้ำตก: ลองมุดอุโมงค์ทีละอัน จำอันที่ถูก/ผิดไว้ =====
local TUNNEL_WORDS = { "tunnel", "hole", "entrance", "entry", "door", "gate", "pipe", "cave", "portal", "path", "exit" }
local STRICT_WORDS = { "tunnel", "hole", "entrance", "entry" }
local wrongSet, goodKey = {}, nil

local function hasWord(name, words)
    local n = string.lower(name)
    for _, w in ipairs(words) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end

local function waitAlive(alive)
    local hrp, hum
    repeat
        task.wait(0.4)
        hrp, hum = NX.getChar()
    until (not alive()) or (hrp and hum and hum.Health > 0)
    task.wait(1.2)
end

-- หาตัวน้ำตก (scope = โฟลเดอร์/ด่านที่จะหาใน, nil = ทั้งแมพ)
local function findWaterfalls(scope)
    local roots = {}
    local function consider(d)
        if d:IsA("Model") or d:IsA("Folder") or d:IsA("BasePart") then
            if string.find(string.lower(d.Name), "waterfall", 1, true) then
                for _, r in ipairs(roots) do
                    if d:IsDescendantOf(r) then return false end
                end
                roots[#roots + 1] = d
            end
        end
        return #roots >= 8
    end
    if scope then
        for _, d in ipairs(scope:GetDescendants()) do
            if consider(d) then break end
        end
    else
        NX.iterWorld(consider)
    end
    return roots
end

local function rootPos(r)
    if r:IsA("BasePart") then return r.Position end
    if r:IsA("Model") then return r:GetPivot().Position end
    local p = r:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position
end

local function tunnelCandidates(root, center)
    local list, seen = {}, {}
    local function add(part)
        local key = part:GetFullName()
        if seen[key] or part.Size.Magnitude > 400 then return end
        seen[key] = true
        list[#list + 1] = { part = part, pos = part.Position, key = key }
    end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("BasePart") and hasWord(d.Name, TUNNEL_WORDS) then add(d) end
    end
    if #list < 2 then
        NX.iterWorld(function(d)
            if d:IsA("BasePart") and (d.Position - center).Magnitude < 250 and hasWord(d.Name, STRICT_WORDS) then
                add(d)
            end
            return #list >= 25
        end)
    end
    if #list == 0 then
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("BasePart") then
                add(c)
            elseif c:IsA("Model") then
                local pp = c.PrimaryPart or c:FindFirstChildWhichIsA("BasePart", true)
                if pp then add(pp) end
            end
        end
    end
    table.sort(list, function(a, b)
        local na = tonumber(string.match(a.part.Name, "(%d+)")) or 0
        local nb = tonumber(string.match(b.part.Name, "(%d+)")) or 0
        if na ~= nb then return na < nb end
        return a.key < b.key
    end)
    return list
end

-- ปลายสองด้านของอุโมงค์ (ตามแกนที่ยาวที่สุด)
local function tunnelEnds(part)
    local s = part.Size
    local axis, len
    if s.X >= s.Y and s.X >= s.Z then
        axis, len = part.CFrame.RightVector, s.X
    elseif s.Y >= s.Z then
        axis, len = part.CFrame.UpVector, s.Y
    else
        axis, len = part.CFrame.LookVector, s.Z
    end
    return part.Position - axis * (len / 2), part.Position + axis * (len / 2)
end

-- ตายเกิดใหม่ หรือโดนวาร์ปออกไปไกลจากจุดอ้างอิง = อุโมงค์ผิด
local function wasKicked(char0, ref)
    local hrp, hum = NX.getChar()
    if player.Character ~= char0 or not hrp or not hum or hum.Health <= 0 then return true end
    return (hrp.Position - ref).Magnitude > 100
end

local function tryTunnel(c, alive)
    local char0 = player.Character
    local hrp0 = NX.getChar()
    if not hrp0 then return "stop" end
    local a, b = tunnelEnds(c.part)
    if (hrp0.Position - b).Magnitude < (hrp0.Position - a).Magnitude then a, b = b, a end
    if not NX.flyTo(a, alive) then return "stop" end
    touch(c.part)
    task.wait(0.9)
    if wasKicked(char0, a) then return "wrong" end
    if not NX.flyTo(b, alive) then return "stop" end
    touch(c.part)
    task.wait(1.1)
    if wasKicked(char0, b) then return "wrong" end
    return "ok"
end

-- กดปุ่ม/พรอมต์/ของรางวัลรอบๆ ตัว (หลังมุดผ่านอุโมงค์) คืนจำนวนที่ได้ผล
local function interactNearby(radius, alive)
    local hrp = NX.getChar()
    if not hrp then return 0 end
    local got = 0
    for _, e in ipairs(collect(nil, nil, false, hrp.Position, radius)) do
        if not alive() then return got end
        if not isDisabled(e) then
            local before = toolCount()
            if not doInteract(e, alive) then return got end
            task.wait(0.8)
            if toolCount() > before or isDisabled(e) then got += 1 end
        end
    end
    return got
end

-- done = ชุดน้ำตกที่ทำไปแล้วในรอบนี้ (กันทำซ้ำ) คืน true ถ้าเจอน้ำตกในแมพ
local function solveWaterfall(alive, scope, done)
    local roots = findWaterfalls(scope)
    for _, root in ipairs(roots) do
        if not alive() then return true end
        if not done[root] then
            done[root] = true
            local center = rootPos(root)
            if center then
                local cands = tunnelCandidates(root, center)
                local ordered = {}
                if goodKey then
                    for _, c in ipairs(cands) do
                        if c.key == goodKey then ordered[#ordered + 1] = c end
                    end
                end
                for _, c in ipairs(cands) do
                    if c.key ~= goodKey and not wrongSet[c.key] then ordered[#ordered + 1] = c end
                end
                if #ordered == 0 then
                    wrongSet = {}
                    ordered = cands
                end
                if #ordered == 0 then
                    qStatus.set("⚠️ เจอน้ำตกแต่ไม่เจออุโมงค์ (กดปุ่ม 🔍 สแกน)", "⚠️ Waterfall found but no tunnels (press 🔍 scan)")
                end
                for i, c in ipairs(ordered) do
                    if not alive() then return true end
                    qStatus.set("น้ำตก: ลองอุโมงค์ " .. i .. "/" .. #ordered .. " (" .. c.part.Name .. ")",
                        "Waterfall: tunnel " .. i .. "/" .. #ordered .. " (" .. c.part.Name .. ")")
                    local res = tryTunnel(c, alive)
                    if res == "ok" then
                        goodKey = c.key
                        qStatus.set("น้ำตก: ✓ อุโมงค์ที่ถูก = " .. c.part.Name .. " กำลังรับของ...",
                            "Waterfall: ✓ correct = " .. c.part.Name .. ", collecting...")
                        interactNearby(150, alive)
                        task.wait(1.5)
                        break
                    elseif res == "wrong" then
                        wrongSet[c.key] = true
                        qStatus.set("น้ำตก: ✗ " .. c.part.Name .. " ผิด ลองอันต่อไป", "Waterfall: ✗ " .. c.part.Name .. " wrong, next")
                        waitAlive(alive)
                    else
                        return true
                    end
                end
            end
        end
    end
    return #roots > 0
end

local function autoWaterfall(alive)
    while alive() do
        local found = solveWaterfall(alive, nil, {})
        if not found then
            qStatus.set("⚠️ ไม่พบน้ำตกในแมพ (กดปุ่ม 🔍 สแกน)", "⚠️ Waterfall not found (press 🔍 scan)")
            return
        end
        qStatus.set("น้ำตก: รอรอบถัดไป...", "Waterfall: waiting next round...")
        task.wait(10)
    end
end

-- ===== ออโต้รับของแต่ละด่าน (ทำภารกิจในด่าน + น้ำตก) =====
local function autoReward(alive)
    while alive() do
        local done = {}
        for i = 1, 10 do
            if not alive() then return end
            local ns = NX.normalStages()
            local st = ns and ns:FindFirstChild("CaveStage" .. i)
            if st then
                for _, e in ipairs(collect(st, nil, false)) do
                    if not alive() then return end
                    if not isDisabled(e) then
                        local before = toolCount()
                        for try = 1, 6 do
                            if not alive() then return end
                            qStatus.set("ด่าน " .. i .. ": ทำภารกิจ (ครั้งที่ " .. try .. ")",
                                "Stage " .. i .. ": doing quest (try " .. try .. ")")
                            if not doInteract(e, alive) then return end
                            task.wait(1)
                            if toolCount() > before or isDisabled(e) then break end
                        end
                    end
                end
                if #findWaterfalls(st) > 0 then
                    qStatus.set("ด่าน " .. i .. ": เจอน้ำตก กำลังหาอุโมงค์ที่ถูก",
                        "Stage " .. i .. ": waterfall found, finding right tunnel")
                    solveWaterfall(alive, st, done)
                end
            end
        end
        -- น้ำตกที่อยู่นอกโมเดลด่าน
        solveWaterfall(alive, nil, done)
        qStatus.set("รอสแกนรอบใหม่...", "Waiting for next scan...")
        task.wait(8)
    end
