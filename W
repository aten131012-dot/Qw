local function iterWorld(fn)
    local n = 0
    for _, top in ipairs(workspace:GetChildren()) do
        local skip = top == workspace.CurrentCamera or top:IsA("Terrain")
            or Players:GetPlayerFromCharacter(top) ~= nil
        if not skip then
            if fn(top) then return end
            for _, d in ipairs(top:GetDescendants()) do
                n += 1
                if n % 3000 == 0 then task.wait() end
                if fn(d) then return end
            end
        end
    end
end
NX.iterWorld = iterWorld

-- ===== ตัวช่วยโต้ตอบกับของในแมพ =====
local function nameHas(inst, words)
    local cur, depth = inst, 0
    while cur and cur ~= workspace and depth < 4 do
        local n = string.lower(cur.Name)
        for _, w in ipairs(words) do
            if string.find(n, w, 1, true) then return true end
        end
        cur = cur.Parent
        depth += 1
    end
    if inst:IsA("ProximityPrompt") then
        local t = string.lower(inst.ActionText .. " " .. inst.ObjectText)
        for _, w in ipairs(words) do
            if string.find(t, w, 1, true) then return true end
        end
    end
    return false
end

local function posOf(d)
    local par = d.Parent
    if par and par:IsA("Attachment") then return par.WorldPosition end
    local p = d:FindFirstAncestorWhichIsA("BasePart")
    if p then return p.Position end
    local m = d:FindFirstAncestorWhichIsA("Model")
    if m then return m:GetPivot().Position end
end

-- root = nil -> ทั้งแมพ / origin+radius = เอาเฉพาะที่อยู่ใกล้จุดนั้น
local function collect(root, words, allowTouch, origin, radius)
    local list = {}
    local function consider(d)
        local isI = d:IsA("ProximityPrompt") or d:IsA("ClickDetector")
            or (allowTouch and d:IsA("TouchTransmitter"))
        if isI and (not words or nameHas(d, words)) then
            local m = d:FindFirstAncestorOfClass("Model")
            local isChar = m and Players:GetPlayerFromCharacter(m)
            local pos = (not isChar) and posOf(d)
            if pos and (not origin or (pos - origin).Magnitude <= radius) then
                list[#list + 1] = { inst = d, pos = pos }
            end
        end
        return #list >= 60
    end
    if root then
        for _, d in ipairs(root:GetDescendants()) do
            if consider(d) then break end
        end
    else
        iterWorld(consider)
    end
    table.sort(list, function(a, b)
        local na = tonumber(string.match(a.inst:GetFullName(), "(%d+)[^%d]*$")) or 0
        local nb = tonumber(string.match(b.inst:GetFullName(), "(%d+)[^%d]*$")) or 0
        if na ~= nb then return na < nb end
        return a.inst:GetFullName() < b.inst:GetFullName()
    end)
    return list
end

local function isDisabled(e)
    return e.inst:IsA("ProximityPrompt") and not e.inst.Enabled
end

local function touch(part)
    local hrp = NX.getChar()
    if not (hrp and part and firetouchinterest) then return end
    pcall(function()
        firetouchinterest(hrp, part, 0)
