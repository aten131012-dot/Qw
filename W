local tabButtons = {}

local function applyLanguage()
    local t = TEXT[NX.lang]
    for i, cat in ipairs(NX.categories) do
        tabButtons[i].Text = cat.emoji .. " " .. t[cat.key]
    end
    for label, key in pairs(labelRefs) do
        label.Text = t[key] or key
    end
    for _, f in ipairs(NX.refreshers) do pcall(f) end
    NX.welcome.Text = t.welcome
    NX.langLabel.Text = "🌐 " .. t.language
    NX.thStroke.Transparency = NX.lang == "th" and 0 or 1
    NX.enStroke.Transparency = NX.lang == "en" and 0 or 1
    local cat = NX.categories[NX.currentTab]
    NX.pageTitle.Text = cat.emoji .. " " .. t[cat.key]
end

local function selectTab(i)
    NX.currentTab = i
    for j, b in ipairs(tabButtons) do
        b:FindFirstChildOfClass("UIStroke").Transparency = (j == i) and 0 or 1
    end
    for key, page in pairs(NX.pages) do
        page.Visible = (key == NX.categories[i].key)
    end
    applyLanguage()
end

for i in ipairs(NX.categories) do
    local b = cuteButton({
        Name = "Tab_" .. i, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 38),
        Text = "", TextSize = 12, TextWrapped = true,
    }, NX.tabScroll)
    round(b, 10)
    stroke(b, WHITE, 2).Transparency = 1
    tabButtons[i] = b
    b.Activated:Connect(function() selectTab(i) end)
end

NX.thButton.Activated:Connect(function() NX.lang = "th"; applyLanguage() end)
NX.enButton.Activated:Connect(function() NX.lang = "en"; applyLanguage() end)

