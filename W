local animId = 0
function NX.setOpen(v)
    NX.isOpen = v
    animId += 1
    local my = animId
    if v then
        mainScale.Scale = 0.6
        main.Visible = true
        tween(mainScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
    else
        local tw = tween(mainScale, 0.16, { Scale = 0.6 })
        tw.Completed:Connect(function()
            if animId == my then main.Visible = false end
        end)
    end
end
