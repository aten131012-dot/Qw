        return false
    end
    local lab = findLabel(name, true)
    if not lab then
        qStatus.set("⚠️ ไม่พบเควส " .. pretty, "⚠️ Quest " .. pretty .. " not found")
        return false
    end
    qStatus.set("เลือกเควส " .. pretty, "Selecting " .. pretty)
    clickGui(lab)
    task.wait(0.7)
    local st = findLabel("start", true)
    if not st then
        qStatus.set("⚠️ ไม่พบปุ่ม Start", "⚠️ Start button not found")
        return false
    end
    qStatus.set("กด Start: " .. pretty, "Pressing Start: " .. pretty)
    clickGui(st)
    task.wait(2)

    local t0 = os.clock()
    local function alive2() return alive() and os.clock() - t0 < qSecs end
    local ctx = {}
    local wasHidden = not questListShown()
    while alive2() do
        qStatus.set("กำลังทำเควส " .. pretty .. " (" .. math.floor(os.clock() - t0) .. "s)",
            "Doing " .. pretty .. " (" .. math.floor(os.clock() - t0) .. "s)")
        local ok, err = pcall(objectivePass, name, ctx, alive2)
        if not ok then qStatus.set("⚠️ " .. tostring(err), "⚠️ " .. tostring(err)) end
        task.wait(0.5)
        local shown = questListShown()
        if wasHidden and shown then break end
        if not shown then wasHidden = true end
    end
    return true
end

