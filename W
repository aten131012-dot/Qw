function NX.toggle(page, order, key, default, cb)
    local row = newRow(page, order)
    rowLabel(row, key, -84)
    local b = cuteButton({
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(60, 26), Text = "OFF", TextSize = 11,
    }, row)
    round(b, 8)
    local state = false
    local obj = {}
    local function paint()
        b.Text = state and "ON" or "OFF"
        b.BackgroundColor3 = state and GREEN or BTN
    end
    b.MouseLeave:Connect(paint)
    b.MouseEnter:Connect(function() if state then b.BackgroundColor3 = GREEN end end)
    function obj.set(v, silent)
        state = v and true or false
        paint()
        if not silent and cb then task.spawn(cb, state) end
    end
    function obj.get() return state end
    b.Activated:Connect(function() obj.set(not state) end)
    if default then obj.set(true) end
    return obj
end

