-- ===== ทำเป้าหมายของแต่ละเควส =====
local function findObjs(words, onlyParts)
    local out = {}
    iterWorld(function(d)
        if d:IsA("BasePart") or ((not onlyParts) and d:IsA("Model")) then
            local n = string.lower(d.Name)
            for _, w in ipairs(words) do
                if string.find(n, w, 1, true) then
                    local pos = d:IsA("Model") and d:GetPivot().Position or d.Position
                    out[#out + 1] = { inst = d, pos = pos }
                    break
                end
            end
        end
        return #out >= 40
    end)
    return out
end

local function cached(ctx, key, words, onlyParts)
    local c = ctx[key]
    if not c or os.clock() - c.t > 15 then
        c = { t = os.clock(), list = findObjs(words, onlyParts) }
        ctx[key] = c
    end
    return c.list
end

local function visit(o, alive)
    if not NX.flyTo(o.pos + Vector3.new(0, 2, 0), alive) then return false end
    local n = 0
    local function hit(x)
        if x:IsA("BasePart") then
            touch(x)
        elseif x:IsA("ProximityPrompt") then
            pcall(function()
                x.HoldDuration = 0
                x.RequiresLineOfSight = false
            end)
            if fireproximityprompt then pcall(fireproximityprompt, x) end
        elseif x:IsA("ClickDetector") then
            if fireclickdetector then pcall(fireclickdetector, x) end
        end
    end
    hit(o.inst)
    for _, x in ipairs(o.inst:GetDescendants()) do
        n += 1
        if n > 25 then break end
        hit(x)
    end
    task.wait(0.3)
    return true
end

local function genericPass(list, alive)
    if #list == 0 then return false end
    local hrp = NX.getChar()
    if hrp then
        table.sort(list, function(a, b)
            return (a.pos - hrp.Position).Magnitude < (b.pos - hrp.Position).Magnitude
        end)
    end
    for _, o in ipairs(list) do
        if not alive() then return true end
        if not visit(o, alive) then return true end
    end
    return true
end

local function soccerPass(ctx, alive)
    local balls = cached(ctx, "ball", { "soccer", "football", "ball" }, true)
    local goals = cached(ctx, "goal", { "goal" }, true)
    if #goals == 0 then goals = cached(ctx, "net", { "net" }, true) end
    local ball
    for _, b in ipairs(balls) do
        local p = b.inst
        if p:IsA("BasePart") and not p.Anchored and p.Size.Magnitude < 30 then ball = p break end
    end
    if not ball or #goals == 0 then return false end
    for _, g in ipairs(goals) do
        if not alive() then return true end
        if not NX.flyTo(ball.Position + Vector3.new(0, 3, 0), alive) then return true end
        for _ = 1, 6 do
            pcall(function()
                ball.AssemblyLinearVelocity = Vector3.zero
                ball.CFrame = CFrame.new(g.pos + Vector3.new(0, 1, 0))
            end)
            if firetouchinterest and g.inst:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(ball, g.inst, 0)
                    firetouchinterest(ball, g.inst, 1)
                end)
            end
            task.wait(0.25)
        end
        if not NX.flyTo(g.pos + Vector3.new(0, 3, 0), alive) then return true end
    end
    return true
end

local OBJ_WORDS = {
    cloud = { "cloud" },
    target = { "target", "bullseye" },
    ramp = { "ramp" },
}

local function objectivePass(name, ctx, alive)
    if name == "soccer" then return soccerPass(ctx, alive) end
    local words = OBJ_WORDS[name] or { name }
    return genericPass(cached(ctx, "obj", words, false), alive)
end

