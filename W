end

local function doInteract(e, alive)
    local d = e.inst
    if not NX.flyTo(e.pos + Vector3.new(0, 3, 0), alive) then return false end
    local hrp = NX.getChar()
    if not hrp then return false end
    pcall(function() hrp.Anchored = true end)
    if d:IsA("ProximityPrompt") then
        pcall(function()
            d.HoldDuration = 0
            d.RequiresLineOfSight = false
            d.MaxActivationDistance = 30
        end)
        if fireproximityprompt then
            pcall(fireproximityprompt, d)
        else
            pcall(function()
                d:InputHoldBegin()
                task.wait(0.1)
                d:InputHoldEnd()
            end)
        end
    elseif d:IsA("ClickDetector") then
        if fireclickdetector then pcall(fireclickdetector, d) end
    elseif d:IsA("TouchTransmitter") and firetouchinterest and d.Parent and d.Parent:IsA("BasePart") then
        pcall(function()
            firetouchinterest(hrp, d.Parent, 0)
            task.wait(0.1)
            firetouchinterest(hrp, d.Parent, 1)
        end)
    end
    task.wait(0.4)
    pcall(function() hrp.Anchored = false end)
    return true
end

